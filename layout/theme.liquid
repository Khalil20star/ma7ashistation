<!doctype html>
{%- liquid
  assign is_rtl = true
  assign dir = 'rtl'
-%}

<html class="no-js hdt-pr-img__effect-{{ settings.effect_secondary_image }} hdt-badge__shape-{{ settings.badge_shape }} dir--{{ dir }}{% if request.design_mode %} shopify-design-mode{% endif %} {% if settings.minimal_products %} hdt-minimal-products{% endif %}{% if settings.hidden_badges %} hdt-hidden-pr-badges{% endif %}{% if settings.hidden_quickview %} hdt-hidden-pr-quickview{% endif %}{% if settings.hidden_wishlist %} hdt-hidden-pr-wishlist{% endif %}{% if settings.hidden_compare %} hdt-hidden-pr-compare{% endif %}{% if settings.uppercase_title %} hdt-pr-uppercase_title{% endif %} {% if settings.layout_boxed %} hdt-layout-boxed{% endif %}" lang="{{ request.locale.iso_code }}" dir="{{ dir }}">
  <head>
    {%- unless template == 'product.only_config' and request.design_mode == false -%}
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 48, height: 48 }}">
    {%- endif -%}

    {%- if settings.library_font == "shopify" -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endif -%}
    {%- if settings.library_font == 'google' -%}{{ settings.embed_google_font }}{%- endif -%}
    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tag' | t }} "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t }} {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}

    {%- liquid
      render 'social-meta-tags'
      render 'css-variables', is_rtl: is_rtl
      render 'js-variables'
      render 'scripts'
      if settings.custom_html_head != blank
        echo settings.custom_html_head
      endif
    -%}
    {{ 'ms-global-font.css' | asset_url | stylesheet_tag }}
    {%- unless request.page_type == 'index' -%}
      {%- render 'ms-storefront-colors' -%}
      {{ 'ms-storefront.css' | asset_url | stylesheet_tag }}
    {%- endunless -%}
    {%- if request.page_type == 'index' -%}
      {{ 'ms-home.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'ms-home.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {{ content_for_header }}
    {%- endunless -%}
  </head>

  <body class="hdt-page-type-{{ request.page_type }}">
    {% comment %} {%- section 'product-card-configs' -%} {% endcomment %}
    {%- unless template == 'product.only_config' and request.design_mode == false -%}
    {%- if request.page_type == "index" or request.page_type == "policy" -%}
    <h1 class="hdt-hidden">{{ page_title | default: shop.name }}</h1>
    {%- endif -%}
    {%- render 's-dom-temp' -%}
    <a class="skip-to-content-link button sr-only " href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>
    {%- unless request.page_type == 'index' -%}
      {%- sections 'header-group' -%}
    {%- endunless -%}
    {%- endunless -%}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
      {%- if template.suffix == 'only_config' -%}
        {%- section 'color-swatch' -%}
      {%- endif -%}
    </main>

    {%- unless template == 'product.only_config' and request.design_mode == false -%}
    {%- unless request.page_type == 'index' -%}
      <footer>
        {%- sections 'footer-group' -%}
      </footer>
    {%- endunless -%}
    {%- liquid
      sections 'system-group'
      if settings.enable_compare_popup
        render 'compare-offcanvas'
      endif
      render 'system-bottom'
      if settings.custom_html_footer != blank
        echo settings.custom_html_footer
      endif
      render 'structured-data'
    -%}
   {%- endunless -%}
  </body>
</html>
