<header class="ms-home ms-header">
  <div class="ms-header__bar">
    <details class="ms-header__menu">
      <summary aria-label="{{ section.settings.menu_label | escape }}">{% render 'ms-icon', icon: 'menu' %}</summary>
      <nav>
        {%- for link in section.settings.menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
      </nav>
    </details>
    <a class="ms-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 400 | image_tag: loading: 'eager', widths: '104, 208, 312, 400', width: 104, alt: section.settings.logo.alt | default: shop.name }}
      {%- else -%}
        <img src="{{ 'ms-logo-header.svg' | asset_url }}" width="104" height="42" alt="{{ shop.name | escape }}">
      {%- endif -%}
    </a>
    <form class="ms-header__search" action="{{ routes.search_url }}" method="get" role="search">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.search_placeholder | escape }}" aria-label="{{ section.settings.search_placeholder | escape }}">
      <button type="submit" aria-label="{{ section.settings.search_placeholder | escape }}">{% render 'ms-icon', icon: 'search' %}</button>
    </form>
    <a class="ms-header__cart" href="{{ routes.cart_url }}" aria-label="{{ 'templates.cart.cart' | t | default: 'السلة' }}">
      {% render 'ms-icon', icon: 'cart' %}
      <hdt-cart-count class="ms-header__cart-count" aria-live="polite">{{ cart.item_count }}</hdt-cart-count>
    </a>
  </div>
</header>
{% stylesheet %}
.shopify-section.ms-header-section{position:sticky;z-index:50;top:0}.ms-header{height:68px;background:#fafafa}.ms-header__bar{position:relative;display:grid;width:100%;height:68px;grid-template-columns:104px minmax(320px,740px) 22px;align-items:center;justify-content:space-between;padding:0 40px;border-bottom:1px solid #e5e5e5;box-shadow:0 2px 12px rgba(0,0,0,.04)}.ms-header__logo{display:block;width:104px;height:42px}.ms-header__logo img{display:block;width:104px;height:42px;object-fit:contain}.ms-header__search{position:relative;width:740px;max-width:100%;height:42px;direction:rtl}.ms-header__search input{width:100%;height:42px;padding:0 16px 0 46px;border:1px solid #cad8d0;border-radius:999px;outline:none;background:#fff;color:#1f423d;font-size:14px;text-align:right}.ms-header__search input::placeholder{color:#bdc5c1}.ms-header__search button{position:absolute;inset-inline-end:0;top:0;display:grid;width:46px;height:42px;padding:0;place-items:center;border:0;background:transparent;color:#1f423d}.ms-header__search svg,.ms-header__cart svg,.ms-header__menu svg{width:22px;height:22px}.ms-header__cart{position:relative;display:block;width:22px;height:22px;color:#1f423d}.ms-header__cart-count{position:absolute;top:-7px;left:-7px;display:grid;width:17px;height:17px;place-items:center;border-radius:50%;background:#d63b32;color:#fff;font-size:9px;font-weight:700}.ms-header__menu{display:none}
@media(max-width:767px){.ms-header{height:116px}.ms-header__bar{display:grid;height:116px;grid-template-columns:22px 1fr 22px;grid-template-rows:58px 58px;padding:0 16px;box-shadow:none}.ms-header__menu{display:block;grid-area:1/1}.ms-header__menu summary{display:block;width:22px;height:22px;cursor:pointer;list-style:none}.ms-header__menu summary::-webkit-details-marker{display:none}.ms-header__menu nav{position:absolute;z-index:30;top:58px;right:0;display:flex;width:100%;flex-direction:column;padding:16px;background:#fff;box-shadow:0 8px 16px rgba(0,0,0,.12)}.ms-header__menu nav a{padding:9px 0;border-bottom:1px solid #eee;font-size:14px}.ms-header__logo,.ms-header__logo img{width:108px;height:44px}.ms-header__logo{grid-area:1/2;justify-self:center}.ms-header__search{grid-area:2/1/3/4;width:100%;height:32px}.ms-header__search input{height:32px;padding:0 12px 0 38px;font-size:10.78px}.ms-header__search button{width:38px;height:32px}.ms-header__search svg{width:18px;height:18px}.ms-header__cart{grid-area:1/3;transform:translateX(6px)}.ms-header__cart-count{top:-3px;left:-6px;width:13px;height:13px}.ms-header__bar>.ms-header__cart{justify-self:end}}
{% endstylesheet %}
{% schema %}
{"name":"MS — Header","class":"ms-header-section","settings":[{"type":"image_picker","id":"logo","label":"Logo"},{"type":"link_list","id":"menu","label":"Mobile menu"},{"type":"text","id":"menu_label","label":"Menu label","default":"القائمة"},{"type":"text","id":"search_placeholder","label":"Search placeholder","default":"البحث"}],"presets":[{"name":"MS — Header"}]}
{% endschema %}
