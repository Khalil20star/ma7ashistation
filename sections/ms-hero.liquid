{%- liquid
  assign has_slide_blocks = false
  if section.blocks.size > 0
    assign has_slide_blocks = true
    assign slide_count = section.blocks.size
  else
    assign slide_count = 1
  endif
-%}

<ms-hero-slider
  class="ms-home ms-hero"
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ section.settings.change_slides_speed | times: 1000 }}"
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.accessibility_label | escape }}"
>
  <div class="ms-hero__track" data-ms-hero-track>
    {%- if has_slide_blocks -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign slide_desktop_image = block.settings.desktop_image | default: section.settings.desktop_image
          assign slide_mobile_image = block.settings.mobile_image | default: section.settings.mobile_image
          assign slide_label = block.settings.accessibility_label | default: section.settings.accessibility_label
          assign slide_link = block.settings.link | default: section.settings.link | default: routes.all_products_collection_url
          if forloop.first
            assign image_loading = 'eager'
          else
            assign image_loading = 'lazy'
          endif
        -%}
        <div
          class="ms-hero__slide{% if forloop.first %} is-active{% endif %}"
          data-ms-hero-slide
          data-block-id="{{ block.id }}"
          role="group"
          aria-roledescription="slide"
          aria-label="{{ forloop.index }} / {{ slide_count }}"
          aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
          {{ block.shopify_attributes }}
        >
          <a class="ms-hero__link" href="{{ slide_link }}" aria-label="{{ slide_label | escape }}"{% unless forloop.first %} tabindex="-1"{% endunless %}>
            <picture>
              {%- if slide_mobile_image != blank -%}
                <source media="(max-width: 767px)" srcset="{{ slide_mobile_image | image_url: width: 1000 }}">
              {%- else -%}
                <source media="(max-width: 767px)" srcset="{{ 'ms-hero-mobile.svg' | asset_url }}">
              {%- endif -%}
              {%- if slide_desktop_image != blank -%}
                {{ slide_desktop_image | image_url: width: 2400 | image_tag: loading: image_loading, widths: '1000, 1440, 1920, 2400', sizes: '100vw', class: 'ms-hero__image', alt: slide_desktop_image.alt | default: slide_label }}
              {%- else -%}
                <img class="ms-hero__image" src="{{ 'ms-hero-desktop.svg' | asset_url }}" width="1920" height="700" loading="{{ image_loading }}" alt="{{ slide_label | escape }}">
              {%- endif -%}
            </picture>
          </a>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="ms-hero__slide is-active" data-ms-hero-slide role="group" aria-roledescription="slide" aria-label="1 / 1" aria-hidden="false">
        <a class="ms-hero__link" href="{{ section.settings.link | default: routes.all_products_collection_url }}" aria-label="{{ section.settings.accessibility_label | escape }}">
          <picture>
            {%- if section.settings.mobile_image != blank -%}
              <source media="(max-width: 767px)" srcset="{{ section.settings.mobile_image | image_url: width: 1000 }}">
            {%- else -%}
              <source media="(max-width: 767px)" srcset="{{ 'ms-hero-mobile.svg' | asset_url }}">
            {%- endif -%}
            {%- if section.settings.desktop_image != blank -%}
              {{ section.settings.desktop_image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '1000, 1440, 1920, 2400', sizes: '100vw', class: 'ms-hero__image', alt: section.settings.desktop_image.alt | default: section.settings.accessibility_label }}
            {%- else -%}
              <img class="ms-hero__image" src="{{ 'ms-hero-desktop.svg' | asset_url }}" width="1920" height="700" loading="eager" alt="{{ section.settings.accessibility_label | escape }}">
            {%- endif -%}
          </picture>
        </a>
      </div>
    {%- endif -%}
  </div>

  {%- if slide_count > 1 -%}
    <div class="ms-hero__dots" role="tablist" aria-label="Hero slides">
      {%- for block in section.blocks -%}
        <button
          class="ms-hero__dot{% if forloop.first %} is-active{% endif %}"
          type="button"
          data-ms-hero-dot="{{ forloop.index0 }}"
          role="tab"
          aria-label="Show slide {{ forloop.index }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
        ></button>
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="ms-hero__dots ms-hero__dots--decorative" aria-hidden="true">
      <i class="is-active"></i><i></i><i></i>
    </div>
  {%- endif -%}
</ms-hero-slider>

<script>
  if (!customElements.get('ms-hero-slider')) {
    customElements.define('ms-hero-slider', class extends HTMLElement {
      connectedCallback() {
        if (this.abortController) return;

        this.abortController = new AbortController();
        this.track = this.querySelector('[data-ms-hero-track]');
        this.slides = Array.from(this.querySelectorAll('[data-ms-hero-slide]'));
        this.dots = Array.from(this.querySelectorAll('[data-ms-hero-dot]'));
        this.currentIndex = 0;
        this.pointerStartX = null;
        this.pointerStartY = null;
        this.pointerId = null;
        this.suppressClickUntil = 0;
        this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        this.dots.forEach((dot) => {
          dot.addEventListener('click', () => {
            this.showSlide(Number(dot.dataset.msHeroDot));
            this.restartAutoplay();
          }, { signal: this.abortController.signal });
        });

        this.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowRight') {
            event.preventDefault();
            this.showSlide(this.currentIndex + 1);
            this.restartAutoplay();
          } else if (event.key === 'ArrowLeft') {
            event.preventDefault();
            this.showSlide(this.currentIndex - 1);
            this.restartAutoplay();
          }
        }, { signal: this.abortController.signal });

        this.addEventListener('pointerdown', (event) => {
          if (!event.isPrimary || (event.pointerType === 'mouse' && event.button !== 0)) return;
          this.pointerStartX = event.clientX;
          this.pointerStartY = event.clientY;
          this.pointerId = event.pointerId;
          this.setPointerCapture?.(event.pointerId);
        }, { signal: this.abortController.signal });

        this.addEventListener('pointerup', (event) => {
          if (this.pointerStartX === null) return;
          const distanceX = event.clientX - this.pointerStartX;
          const distanceY = event.clientY - this.pointerStartY;
          if (this.hasPointerCapture?.(event.pointerId)) this.releasePointerCapture(event.pointerId);
          this.pointerStartX = null;
          this.pointerStartY = null;
          this.pointerId = null;
          if (Math.abs(distanceX) < 45 || Math.abs(distanceY) >= Math.abs(distanceX)) return;
          this.suppressClickUntil = performance.now() + 350;
          this.showSlide(this.currentIndex + (distanceX > 0 ? 1 : -1));
          this.restartAutoplay();
        }, { signal: this.abortController.signal });

        this.addEventListener('pointercancel', () => {
          this.pointerStartX = null;
          this.pointerStartY = null;
          this.pointerId = null;
        }, { signal: this.abortController.signal });

        this.addEventListener('click', (event) => {
          if (performance.now() >= this.suppressClickUntil) return;
          event.preventDefault();
          event.stopPropagation();
        }, { capture: true, signal: this.abortController.signal });

        this.addEventListener('mouseenter', () => this.stopAutoplay(), { signal: this.abortController.signal });
        this.addEventListener('mouseleave', () => this.startAutoplay(), { signal: this.abortController.signal });
        this.addEventListener('focusin', () => this.stopAutoplay(), { signal: this.abortController.signal });
        this.addEventListener('focusout', () => this.startAutoplay(), { signal: this.abortController.signal });

        document.addEventListener('shopify:block:select', (event) => {
          const selectedSlide = this.querySelector(`[data-block-id="${event.detail.blockId}"]`);
          if (!selectedSlide) return;
          this.stopAutoplay();
          this.showSlide(this.slides.indexOf(selectedSlide));
        }, { signal: this.abortController.signal });

        document.addEventListener('shopify:block:deselect', () => this.startAutoplay(), { signal: this.abortController.signal });

        this.showSlide(0, false);
        this.startAutoplay();
      }

      disconnectedCallback() {
        this.stopAutoplay();
        this.abortController?.abort();
        this.abortController = null;
      }

      showSlide(index, animate = true) {
        if (this.slides.length < 1) return;
        this.currentIndex = (index + this.slides.length) % this.slides.length;
        this.track.classList.toggle('is-static', !animate);
        this.track.style.transform = `translate3d(${this.currentIndex * 100}%, 0, 0)`;

        this.slides.forEach((slide, slideIndex) => {
          const active = slideIndex === this.currentIndex;
          slide.classList.toggle('is-active', active);
          slide.setAttribute('aria-hidden', String(!active));
          const link = slide.querySelector('a');
          if (link) link.tabIndex = active ? 0 : -1;
        });

        this.dots.forEach((dot, dotIndex) => {
          const active = dotIndex === this.currentIndex;
          dot.classList.toggle('is-active', active);
          dot.setAttribute('aria-selected', String(active));
        });

        if (!animate) requestAnimationFrame(() => this.track.classList.remove('is-static'));
      }

      startAutoplay() {
        if (this.dataset.autoplay !== 'true' || this.slides.length < 2 || this.reducedMotion || this.autoplayTimer) return;
        const interval = Math.max(Number(this.dataset.interval) || 5000, 3000);
        this.autoplayTimer = window.setInterval(() => this.showSlide(this.currentIndex + 1), interval);
      }

      stopAutoplay() {
        window.clearInterval(this.autoplayTimer);
        this.autoplayTimer = null;
      }

      restartAutoplay() {
        this.stopAutoplay();
        this.startAutoplay();
      }
    });
  }
</script>
{% stylesheet %}
.ms-hero{position:relative;display:block;width:100%;height:485px;overflow:hidden;background:#0c433b}.ms-hero__track{display:flex;width:100%;height:100%;direction:ltr;transition:transform .55s ease;will-change:transform}.ms-hero__track.is-static{transition:none}.ms-hero__slide{width:100%;height:100%;flex:0 0 100%}.ms-hero__link,.ms-hero picture,.ms-hero__image{display:block;width:100%;height:100%}.ms-hero__image{object-fit:cover;object-position:center}.ms-hero__dots{position:absolute;z-index:2;bottom:23px;left:50%;display:flex;height:9px;align-items:center;gap:7px;direction:rtl;transform:translateX(-50%)}.ms-hero__dot,.ms-hero__dots--decorative i{display:block;width:9px;height:9px;padding:0;border:0;border-radius:50%;background:rgba(255,255,255,.45)}.ms-hero__dot{cursor:pointer;transition:width .25s ease,background-color .25s ease}.ms-hero__dot.is-active,.ms-hero__dots--decorative i.is-active{width:26px;border-radius:5px;background:#fff}@media(prefers-reduced-motion:reduce){.ms-hero__track,.ms-hero__dot{transition:none}}@media(max-width:767px){.ms-hero{height:373px}.ms-hero__dots{bottom:17px;height:8px}.ms-hero__dot,.ms-hero__dots--decorative i{width:8px;height:8px}.ms-hero__dot.is-active,.ms-hero__dots--decorative i.is-active{width:22px}.ms-hero__image{object-position:center}}
.ms-hero__track{direction:rtl}
{% endstylesheet %}
