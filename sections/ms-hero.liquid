{"name":"MS — Hero","max_blocks":6,"settings":[{"type":"text","id":"accessibility_label","label":"Carousel description","default":"محطة المحاشي الشهية — طعم يأخذك إلى عالم آخر"},{"type":"checkbox","id":"autoplay","label":"Auto-rotate slides","default":true},{"type":"range","id":"change_slides_speed","min":3,"max":10,"step":1,"unit":"s","label":"Change slides every","default":5},{"type":"header","content":"Legacy single-slide fallback"},{"type":"paragraph","content":"These settings remain available for existing stores. Add slide blocks below to use multiple images."},{"type":"image_picker","id":"desktop_image","label":"Desktop image"},{"type":"image_picker","id":"mobile_image","label":"Mobile image"},{"type":"url","id":"link","label":"Link"}],"blocks":[{"type":"slide","name":"Slide","settings":[{"type":"image_picker","id":"desktop_image","label":"Desktop image"},{"type":"image_picker","id":"mobile_image","label":"Mobile image"},{"type":"text","id":"accessibility_label","label":"Image description","default":"محطة المحاشي الشهية — طعم يأخذك إلى عالم آخر"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"MS — Hero","blocks":[{"type":"slide"},{"type":"slide"},{"type":"slide"}]}]}
{% endschema %}
