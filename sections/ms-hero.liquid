<section class="ms-home ms-hero">
  <a class="ms-hero__link" href="{{ section.settings.link | default: routes.all_products_collection_url }}" aria-label="{{ section.settings.accessibility_label | escape }}">
    <picture>
      {%- if section.settings.mobile_image != blank -%}
        <source media="(max-width: 767px)" srcset="{{ section.settings.mobile_image | image_url: width: 1000 }}">
      {%- else -%}
        <source media="(max-width: 767px)" srcset="{{ 'ms-hero-mobile.svg' | asset_url }}">
      {%- endif -%}
      {%- if section.settings.desktop_image != blank -%}
        {{ section.settings.desktop_image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '1000, 1440, 1920, 2400', sizes: '100vw', class: 'ms-hero__image', alt: section.settings.desktop_image.alt | default: section.settings.accessibility_label }}
      {%- else -%}
        <img class="ms-hero__image" src="{{ 'ms-hero-desktop.svg' | asset_url }}" width="1920" height="700" alt="{{ section.settings.accessibility_label | escape }}">
      {%- endif -%}
    </picture>
  </a>
  <div class="ms-hero__dots" aria-hidden="true"><i></i><i></i><i></i></div>
</section>
{% stylesheet %}
.ms-hero{position:relative;width:100%;height:485px;overflow:hidden;background:#0c433b}.ms-hero__link,.ms-hero picture,.ms-hero__image{display:block;width:100%;height:100%}.ms-hero__image{object-fit:cover;object-position:center}.ms-hero__dots{position:absolute;bottom:23px;left:50%;display:flex;height:9px;align-items:center;gap:7px;direction:ltr;transform:translateX(-50%)}.ms-hero__dots i{display:block;width:9px;height:9px;border-radius:50%;background:rgba(255,255,255,.45)}.ms-hero__dots i:last-child{width:26px;border-radius:5px;background:#fff}@media(max-width:767px){.ms-hero{height:373px}.ms-hero__dots{bottom:17px}.ms-hero__dots i{width:8px;height:8px}.ms-hero__dots i:last-child{width:22px}.ms-hero__image{object-position:center}}
{% endstylesheet %}
{% schema %}
{"name":"MS — Hero","settings":[{"type":"text","id":"accessibility_label","label":"Image description","default":"محطة المحاشي الشهية — طعم يأخذك إلى عالم آخر"},{"type":"image_picker","id":"desktop_image","label":"Desktop image"},{"type":"image_picker","id":"mobile_image","label":"Mobile image"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"MS — Hero"}]}
{% endschema %}
