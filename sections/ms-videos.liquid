{%- assign videos_collection = section.settings.collection | default: collections.all -%}
<section class="ms-home ms-videos">
  <div class="ms-home__container">
    <header>
      <h2 class="ms-home__title">{{ section.settings.heading }}</h2>
      <p class="ms-home__subtitle">{{ section.settings.text }}</p>
    </header>
    <div class="ms-videos__viewport ms-home__rail">
      <div class="ms-videos__track">
        {%- for product in videos_collection.products limit: 5 -%}
          {%- assign variant = product.selected_or_first_available_variant -%}
          <a class="ms-videos__card" href="{{ product.url }}">
            {%- if product.featured_image -%}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 600, 900', sizes: '(max-width: 767px) 261px, 280px', class: 'ms-videos__image', alt: product.title }}{%- endif -%}
            <span class="ms-videos__play">{% render 'ms-icon', icon: 'play' %}</span>
            <span class="ms-videos__product">
              <span><b>{{ product.title }}</b><em>{% if variant.compare_at_price > variant.price %}<s>{{ variant.compare_at_price | money_without_trailing_zeros }}</s>{% endif %}<strong>{{ variant.price | money_without_trailing_zeros }}</strong></em></span>
              {%- if product.featured_image -%}{{ product.featured_image | image_url: width: 100 | image_tag: loading: 'lazy', width: 50, height: 50, alt: product.title }}{%- endif -%}
            </span>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{% stylesheet %}
.ms-videos{height:662px;overflow:hidden;background:#fff}.ms-videos>.ms-home__container{height:100%;padding-top:40px}.ms-videos header{height:72px}.ms-videos header .ms-home__subtitle{margin-top:8px}.ms-videos__viewport{width:100%;height:478px;margin-top:32px;overflow:hidden}.ms-videos__track{display:flex;width:max-content;height:478px;gap:14px;direction:ltr;transform:translateX(-96px)}.ms-videos__card{position:relative;display:block;width:280px;height:478px;flex:0 0 280px;overflow:hidden;border-radius:18px;background:#07594f;direction:rtl}.ms-videos__image{display:block;width:100%;height:100%;object-fit:cover}.ms-videos__play{position:absolute;top:215px;left:50%;display:grid;width:48px;height:48px;place-items:center;border-radius:50%;background:#fff;color:#1b5735;transform:translateX(-50%)}.ms-videos__play svg{width:25px;height:25px}.ms-videos__product{position:absolute;right:10px;bottom:12.6px;left:auto;display:flex;width:212px;height:76px;align-items:center;justify-content:flex-start;gap:8px;padding:10px 12px;border-radius:12px;background:#fff}.ms-videos__product>span{min-width:0;flex:1}.ms-videos__product b{display:block;overflow:hidden;font-size:14px;font-weight:700;white-space:nowrap;text-overflow:ellipsis}.ms-videos__product em{display:flex;gap:7px;margin-top:7px;align-items:center;font-style:normal}.ms-videos__product s{color:#888;font-size:11px}.ms-videos__product strong{color:#ff3b30;font-size:16px;font-weight:800}.ms-videos__product img{width:50px;height:50px;flex:0 0 50px;border-radius:50%;object-fit:cover}
@media(max-width:767px){.ms-videos{height:550px}.ms-videos>.ms-home__container{padding:16px 0 0}.ms-videos header{height:56px;padding-inline:16px}.ms-videos header .ms-home__title{white-space:nowrap}.ms-videos header .ms-home__subtitle{margin-top:5px;font-weight:500}.ms-videos__viewport{height:446px;margin-top:16px}.ms-videos__track{height:444.96px;gap:13.03px;transform:translateX(-231px)}.ms-videos__card{width:260.65px;height:444.96px;flex-basis:260.65px;border-radius:17px}.ms-videos__play{top:199px;width:46px;height:46px}.ms-videos__product{right:20.31px;bottom:15.67px;left:auto;width:175.35px;height:62.86px;gap:6.62px;padding:8.27px 9.93px}.ms-videos__product b{font-size:13.03px}.ms-videos__product em{margin-top:4px}.ms-videos__product s{font-size:10.24px}.ms-videos__product strong{font-size:14.89px}.ms-videos__product img{width:41.36px;height:41.36px;flex-basis:41.36px}}
.ms-videos__product{direction:ltr}.ms-videos__product>span{direction:rtl}.ms-videos__product em{justify-content:flex-end;direction:ltr}
{% endstylesheet %}
{% schema %}
{"name":"MS — Videos","settings":[{"type":"text","id":"heading","label":"Heading","default":"يسعدنا نشاركك أجمل اللحظات"},{"type":"text","id":"text","label":"Description","default":"اضغط على أي فيديو واطلب مباشرة"},{"type":"collection","id":"collection","label":"Products collection"}],"presets":[{"name":"MS — Videos"}]}
{% endschema %}
