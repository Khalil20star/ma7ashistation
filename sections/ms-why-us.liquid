<section class="ms-home ms-why">
  <div class="ms-home__container">
    <header class="ms-why__header">
      <h2 class="ms-home__title">{{ section.settings.heading }}</h2>
      <p class="ms-home__subtitle">{{ section.settings.text }}</p>
    </header>
    <div class="ms-why__grid">
      {%- for block in section.blocks -%}
        <article class="ms-why__card" {{ block.shopify_attributes }}>
          <span class="ms-why__icon">{% render 'ms-icon', icon: block.settings.icon %}</span>
          <div><h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p></div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{% style %}
.ms-why{position:relative;height:361.6px;overflow:hidden;background:#d9c6ae url("{{ 'ms-why-desktop-v2.png' | asset_url }}") center/cover no-repeat}.ms-why:before{position:absolute;inset:0;background:rgba(245,237,224,.38);content:""}.ms-why>.ms-home__container{position:relative;height:100%;padding-top:40px}.ms-why__header{height:80px}.ms-why__header .ms-home__subtitle{margin-top:15px}.ms-why__grid{display:grid;width:1060px;height:185.6px;margin:16px auto 0;grid-template-columns:repeat(2,1fr);grid-auto-rows:84.8px;gap:16px 16.96px}.ms-why__card{display:flex;align-items:center;gap:16.96px;padding:14.8px 25px;border-radius:16.96px;background:#fff}.ms-why__icon{display:grid;width:55.1px;height:55.1px;flex:0 0 55.1px;place-items:center;border-radius:14.84px;background:#eff4f1;color:#1b5735}.ms-why__icon svg{width:28px;height:28px}.ms-why__card div{flex:1}.ms-why__card h3{margin:0 0 4.24px;font-size:16px;font-weight:700;line-height:18.85px}.ms-why__card p{margin:0;color:#737373;font-size:13px;font-weight:500;line-height:17.55px}@media(max-width:767px){.ms-why{height:421px;background-image:url("{{ 'ms-why-mobile-v2.png' | asset_url }}")}.ms-why:before{background:rgba(245,237,224,.35)}.ms-why>.ms-home__container{padding-top:16px}.ms-why__header{height:77px}.ms-why__header .ms-home__subtitle{margin-top:6px;font-weight:500}.ms-why__grid{width:343px;height:296px;margin-top:16px;grid-template-columns:repeat(2,163.5px);grid-auto-rows:142px;gap:12px}.ms-why__card{height:142px;flex-direction:column;align-items:stretch;gap:8px;padding:14px 12px;border-radius:14px}.ms-why__icon{align-self:flex-start;width:38px;height:38px;flex-basis:38px;border-radius:10px}.ms-why__icon svg{width:24px;height:24px}.ms-why__card h3{margin:0 0 8px;font-size:13px;font-weight:500;line-height:18.85px}.ms-why__card p{font-size:11px;font-weight:400;line-height:14px}}
.ms-why__grid,.ms-why__card{direction:rtl}
{% endstyle %}
{% schema %}
{"name":"MS — Why us","max_blocks":4,"settings":[{"type":"text","id":"heading","label":"Heading","default":"ليش تختار محاشي ستيشن ؟"},{"type":"textarea","id":"text","label":"Description","default":"نجهز لك محاشي طازجة بنكهات غنية، تغليف مرتب، وتوصيل سريع يخلي طلبك يوصل ساخن ولذيذ بكل مرة."}],"blocks":[{"type":"reason","name":"Reason","settings":[{"type":"select","id":"icon","label":"Icon","options":[{"value":"star","label":"Star"},{"value":"box","label":"Box"},{"value":"truck","label":"Truck"},{"value":"sparkle","label":"Sparkle"}],"default":"star"},{"type":"text","id":"heading","label":"Heading","default":"جودة بطعم يفرق"},{"type":"textarea","id":"text","label":"Description","default":"مكونات طازجة وتتبيلات موزونة تعطيك نكهة غنية بكل لقمة."}]}],"presets":[{"name":"MS — Why us","blocks":[{"type":"reason","settings":{"icon":"star","heading":"جودة بطعم يفرق","text":"مكونات طازجة وتتبيلات موزونة تعطيك نكهة غنية بكل لقمة."}},{"type":"reason","settings":{"icon":"box","heading":"تغليف مرتب وآمن","text":"تغليف عملي يحافظ على حرارة الأكل بدون تسريب."}},{"type":"reason","settings":{"icon":"truck","heading":"توصيل سريع","text":"بالتعاون مع جاهز وطلبات، طلبك يوصل ساخن وطازج."}},{"type":"reason","settings":{"icon":"sparkle","heading":"نظافة بمعايير عالية","text":"أعلى معايير النظافة داخل المطبخ لضمان سلامة طلبك."}}]}]}
{% endschema %}
