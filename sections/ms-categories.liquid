<section class="ms-home ms-categories">
  <div class="ms-home__container">
    <h2 class="ms-home__title">{{ section.settings.heading }}</h2>
    <div class="ms-categories__viewport ms-home__rail">
      <div class="ms-categories__rail">
        {%- for block in section.blocks -%}
          {%- liquid
            assign pill_collection = block.settings.collection
            assign pill_image = block.settings.image | default: pill_collection.featured_image
            if pill_image == blank
              assign pill_image = collections.all.products[forloop.index0].featured_image
            endif
          -%}
          <a class="ms-categories__pill{% if block.settings.active %} is-active{% endif %}" href="{{ pill_collection.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
            {%- if pill_image != blank -%}{{ pill_image | image_url: width: 100 | image_tag: loading: 'lazy', width: 39, height: 39, alt: block.settings.title }}{%- endif -%}
            <b>{{ block.settings.title | default: pill_collection.title }}</b><span aria-hidden="true">‹</span>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{% stylesheet %}
.ms-categories{height:184px;overflow:hidden;background:#fafafa}.ms-categories>.ms-home__container{height:100%;padding-top:40px;padding-bottom:36px}.ms-categories__viewport{width:calc(100% + 14px);margin-inline:-7px;overflow:hidden}.ms-categories__rail{display:flex;width:max-content;height:58px;align-items:center;gap:9.9px;padding:3px 13.7px;direction:ltr}.ms-categories__pill{display:flex;width:139.2px;height:52px;flex:0 0 139.2px;align-items:center;gap:7px;padding:6.5px 8.5px;border:1px solid #dbe4de;border-radius:44.3px;background:#fff;color:#173e32;direction:rtl}.ms-categories__pill.is-active{background:rgba(221,234,226,.7)}.ms-categories__pill img{width:38.7px;height:38.7px;flex:0 0 38.7px;border-radius:50%;object-fit:cover}.ms-categories__pill b{margin-inline-start:auto;font-size:14px;font-weight:700;white-space:nowrap}.ms-categories__pill span{color:#c8ceca;font-size:18px}@media(max-width:767px){.ms-categories{height:130px}.ms-categories>.ms-home__container{padding-top:16px;padding-bottom:16px}.ms-categories__viewport{width:calc(100% + 32px);margin-inline:-16px}.ms-categories__rail{height:72px;gap:8px;padding:10px 0;transform:translateX(-196px)}.ms-categories__pill{width:139px;flex-basis:139px;height:52px}.ms-categories__pill img{width:38.3px;height:38.3px}.ms-categories__pill b{font-size:12px}}
{% endstylesheet %}
{% schema %}
{"name":"MS — Categories","max_blocks":12,"settings":[{"type":"text","id":"heading","label":"Heading","default":"اطلب حسب التصنيف"}],"blocks":[{"type":"category","name":"Category","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"image_picker","id":"image","label":"Custom image"},{"type":"text","id":"title","label":"Title"},{"type":"checkbox","id":"active","label":"Highlighted","default":false}]}],"presets":[{"name":"MS — Categories","blocks":[{"type":"category","settings":{"title":"بوكس تقديم"}},{"type":"category","settings":{"title":"الجدور"}},{"type":"category","settings":{"title":"صوصات"}},{"type":"category","settings":{"title":"حلويات مبردة"}},{"type":"category","settings":{"title":"الفتة"}},{"type":"category","settings":{"title":"الأكثر مبيعاً"}},{"type":"category","settings":{"title":"بوفيهات"}},{"type":"category","settings":{"title":"مفرزنات","active":true}},{"type":"category","settings":{"title":"أطباق"}}]}]}
{% endschema %}
