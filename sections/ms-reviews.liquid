<section class="ms-home ms-reviews">
  <div class="ms-reviews__inner">
    <div class="ms-reviews__info">
      <span>{{ section.settings.badge }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <div>
        <b>★★★★★</b>
        <p>{{ section.settings.summary }}</p>
      </div>
    </div>
    <ms-reviews-carousel class="ms-reviews__slider">
      <button class="ms-reviews__arrow" type="button" data-ms-reviews-previous aria-label="السابق">›</button>
      <div class="ms-reviews__viewport" aria-live="polite">
        {%- for block in section.blocks -%}
          <blockquote
            data-ms-review-slide
            data-block-id="{{ block.id }}"
            aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
            {% unless forloop.first %}hidden{% endunless %}
            {{ block.shopify_attributes }}
          >
            <div>★★★★★</div>
            <p>{{ block.settings.text }}</p>
            <cite>{{ block.settings.author }}</cite>
            <small>{{ block.settings.location }}</small>
          </blockquote>
        {%- endfor -%}
      </div>
      <button class="ms-reviews__arrow" type="button" data-ms-reviews-next aria-label="التالي">‹</button>
      <div class="ms-reviews__dots" role="group" aria-label="Customer reviews">
        {%- for block in section.blocks -%}
          <button
            type="button"
            data-ms-review-dot="{{ forloop.index0 }}"
            aria-label="Review {{ forloop.index }}"
            aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
          ></button>
        {%- endfor -%}
      </div>
    </ms-reviews-carousel>
  </div>
</section>

<script>
  if (!customElements.get('ms-reviews-carousel')) {
    customElements.define('ms-reviews-carousel', class extends HTMLElement {
      connectedCallback() {
        if (this.abortController) return;

        this.abortController = new AbortController();
        this.viewport = this.querySelector('.ms-reviews__viewport');
        this.slides = Array.from(this.querySelectorAll('[data-ms-review-slide]'));
        this.dots = Array.from(this.querySelectorAll('[data-ms-review-dot]'));
        this.previousButton = this.querySelector('[data-ms-reviews-previous]');
        this.nextButton = this.querySelector('[data-ms-reviews-next]');
        this.currentIndex = 0;
        this.pointerStartX = null;
        this.pointerStartY = null;

        this.previousButton?.addEventListener('click', () => this.showSlide(this.currentIndex - 1), {
          signal: this.abortController.signal
        });
        this.nextButton?.addEventListener('click', () => this.showSlide(this.currentIndex + 1), {
          signal: this.abortController.signal
        });

        this.dots.forEach((dot) => {
          dot.addEventListener('click', () => this.showSlide(Number(dot.dataset.msReviewDot)), {
            signal: this.abortController.signal
          });
        });

        this.viewport?.addEventListener('pointerdown', (event) => {
          if (!event.isPrimary || (event.pointerType === 'mouse' && event.button !== 0)) return;
          this.pointerStartX = event.clientX;
          this.pointerStartY = event.clientY;
          this.viewport.setPointerCapture?.(event.pointerId);
        }, { signal: this.abortController.signal });

        this.viewport?.addEventListener('pointerup', (event) => {
          if (this.pointerStartX === null) return;
          const distanceX = event.clientX - this.pointerStartX;
          const distanceY = event.clientY - this.pointerStartY;
          if (this.viewport.hasPointerCapture?.(event.pointerId)) this.viewport.releasePointerCapture(event.pointerId);
          this.pointerStartX = null;
          this.pointerStartY = null;
          if (Math.abs(distanceX) < 42 || Math.abs(distanceY) >= Math.abs(distanceX)) return;
          this.showSlide(this.currentIndex + (distanceX < 0 ? 1 : -1));
        }, { signal: this.abortController.signal });

        this.viewport?.addEventListener('pointercancel', () => {
          this.pointerStartX = null;
          this.pointerStartY = null;
        }, { signal: this.abortController.signal });

        document.addEventListener('shopify:block:select', (event) => {
          const selectedSlide = this.slides.find((slide) => slide.dataset.blockId === event.detail.blockId);
          if (selectedSlide) this.showSlide(this.slides.indexOf(selectedSlide));
        }, { signal: this.abortController.signal });

        this.showSlide(0);
      }

      disconnectedCallback() {
        this.abortController?.abort();
        this.abortController = null;
      }

      showSlide(index) {
        if (this.slides.length < 1) return;
        this.currentIndex = (index + this.slides.length) % this.slides.length;

        this.slides.forEach((slide, slideIndex) => {
          const active = slideIndex === this.currentIndex;
          slide.hidden = !active;
          slide.setAttribute('aria-hidden', String(!active));
        });

        this.dots.forEach((dot, dotIndex) => {
          dot.setAttribute('aria-current', String(dotIndex === this.currentIndex));
        });

        const singleSlide = this.slides.length < 2;
        if (this.previousButton) this.previousButton.disabled = singleSlide;
        if (this.nextButton) this.nextButton.disabled = singleSlide;
      }
    });
  }
</script>
{% stylesheet %}
  .ms-reviews {
    height: 316px;
    overflow: hidden;
    background: #e1c4a933;
  }
  .ms-reviews__inner {
    display: flex;
    width: 100%;
    height: 100%;
    justify-content: space-evenly;
    align-items: center;
    gap: 40px;
    padding: 40px 60.5px;
  }
  .ms-reviews__info {
    display: flex;
    width: 347px;
    height: 197px;
    flex: 0 0 347px;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }
  .ms-reviews__info > span {
    display: grid;
    width: 127px;
    height: 32px;
    place-items: center;
    border-radius: 50px;
    background: #1f423d;
    color: #fff;
    font-size: 13px;
    font-weight: 500;
  }
  .ms-reviews__info h2 {
    width: 347px;
    margin: 0;
    color: #1f423d;
    font-size: 44px;
    font-weight: 900;
    line-height: 52px;
  }
  .ms-reviews__info > div {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .ms-reviews__info b {
    color: #f5bd27;
    font-size: 16px;
    font-weight: 400;
    letter-spacing: 0;
  }
  .ms-reviews__info p {
    margin: 0;
    color: #9a9a9a;
    font-size: 17px;
    font-weight: 400;
    white-space: nowrap;
  }
  .ms-reviews__slider {
    position: relative;
    display: flex;
    width: 932px;
    height: 226px;
    align-items: center;
    gap: 14px;
    padding-bottom: 26px;
  }
  .ms-reviews__slider blockquote {
    display: flex;
    width: 772px;
    height: 200px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin: 0;
    padding: 24px 56px;
    border-radius: 18px;
    background: #fff;
    direction: rtl;
  }
  .ms-reviews__slider blockquote div {
    color: #f5bd27;
    font-size: 24px;
    font-weight: 400;
    letter-spacing: 4px;
  }
  .ms-reviews__slider blockquote p {
    margin: 4px 0 18px;
    color: #333;
    font-size: 17px;
    line-height: 30px;
    text-align: center;
  }
  .ms-reviews__slider cite {
    font-size: 16px;
    font-style: normal;
    font-weight: 700;
  }
  .ms-reviews__slider small {
    color: #aaa;
    font-size: 14px;
  }
  .ms-reviews__arrow {
    display: grid;
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    padding: 0;
    place-items: center;
    border: 2px solid #ddd;
    border-radius: 50%;
    background: #fff;
    color: #777;
    font: 32px/1 Arial;
  }
  .ms-reviews__dots {
    position: absolute;
    bottom: 0;
    left: 50%;
    display: flex;
    gap: 7px;
    transform: translateX(-50%);
  }
  .ms-reviews__dots button {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #c4d1cf;
    cursor: pointer;
  }
  .ms-reviews__dots button[aria-current="true"] {
    width: 22px;
    border-radius: 4px;
    background: #1f5348;
  }
  .ms-reviews__viewport {
    width: 772px;
    min-width: 0;
    overflow: hidden;
    touch-action: pan-y pinch-zoom;
  }
  .ms-reviews__viewport blockquote[hidden] {
    display: none;
  }
  .ms-reviews__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }
  @media (max-width: 767px) {
    .ms-reviews {
      height: 445px;
    }
    .ms-reviews__inner {
      flex-direction: column;
      gap: 16px;
      padding: 19.5px 14px;
    }
    .ms-reviews__info {
      width: 347px;
      height: 139px;
      flex: 0 0 139px;
      align-items: center;
    }
    .ms-reviews__info h2 {
      width: 347px;
      font-size: 22px;
      font-weight: 800;
      line-height: 26px;
      text-align: center;
    }
    .ms-reviews__info > div {
      flex-direction: column;
      gap: 8px;
    }
    .ms-reviews__info b {
      font-size: 16px;
    }
    .ms-reviews__info p {
      font-size: 13px;
      font-weight: 500;
      line-height: 18.85px;
    }
    .ms-reviews__slider {
      width: 329px;
      height: 251px;
      flex: 0 0 251px;
      padding: 0 0 26px;
    }
    .ms-reviews__viewport {
      width: 100%;
    }
    .ms-reviews__slider blockquote {
      width: 343px;
      height: 225px;
      flex: 0 0 343px;
      transform: translateX(-7px);
      padding: 20px 35px;
      border-radius: 18px;
    }
    .ms-reviews__slider blockquote div {
      font-size: 24px;
    }
    .ms-reviews__slider blockquote p {
      margin: 4px 0 0;
      font-size: 17px;
      line-height: 30px;
    }
    .ms-reviews__slider blockquote cite {
      font-size: 16px;
    }
    .ms-reviews__slider blockquote small {
      font-size: 14px;
    }
    .ms-reviews__slider .ms-reviews__arrow {
      display: none;
    }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "MS — Reviews",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge", "default": "شهادات العملاء" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "مئات من التقييمات 5 نجوم" },
    { "type": "text", "id": "summary", "label": "Summary", "default": "أكثر من 1,500 عميل سعيد من طلباته" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Review",
          "default": "محاشي ستيشن، طازجة ولذيذة! المحاشي كلها طازة والتغليف مرتب، وصلني الأكل حار وأنيق."
        },
        { "type": "text", "id": "author", "label": "Author", "default": "فهد المنيفي" },
        { "type": "text", "id": "location", "label": "Location", "default": "الكويت - الجهراء" }
      ]
    }
  ],
  "presets": [{ "name": "MS — Reviews", "blocks": [{ "type": "review" }] }]
}
{% endschema %}
