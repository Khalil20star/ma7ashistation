<section class="ms-home ms-reviews">
  <div class="ms-reviews__inner">
    <div class="ms-reviews__info">
      <span>{{ section.settings.badge }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <div><b>★★★★★</b><p>{{ section.settings.summary }}</p></div>
    </div>
    <div class="ms-reviews__slider">
      <button class="ms-reviews__arrow" type="button" aria-label="السابق">‹</button>
      {%- assign first_review = section.blocks.first -%}
      <blockquote>
        <div>★★★★★</div>
        <p>{{ first_review.settings.text }}</p>
        <cite>{{ first_review.settings.author }}</cite>
        <small>{{ first_review.settings.location }}</small>
      </blockquote>
      <button class="ms-reviews__arrow" type="button" aria-label="التالي">›</button>
      <div class="ms-reviews__dots" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
    </div>
  </div>
</section>
{% stylesheet %}
.ms-reviews{height:316px;overflow:hidden;background:#e1c4a9}.ms-reviews__inner{display:flex;width:100%;height:100%;align-items:center;gap:40px;padding:40px 60.5px}.ms-reviews__info{display:flex;width:347px;height:197px;flex:0 0 347px;flex-direction:column;align-items:flex-start;gap:18px}.ms-reviews__info>span{display:grid;width:127px;height:32px;place-items:center;border-radius:50px;background:#1f423d;color:#fff;font-size:13px;font-weight:500}.ms-reviews__info h2{width:347px;margin:0;color:#1f423d;font-size:44px;font-weight:900;line-height:52px}.ms-reviews__info>div{display:flex;align-items:center;gap:8px}.ms-reviews__info b{color:#f5bd27;font-size:16px;font-weight:400;letter-spacing:0}.ms-reviews__info p{margin:0;color:#9a9a9a;font-size:17px;font-weight:400;white-space:nowrap}.ms-reviews__slider{position:relative;display:flex;width:932px;height:226px;align-items:center;gap:14px;padding-bottom:26px;direction:ltr}.ms-reviews__slider blockquote{display:flex;width:772px;height:200px;flex-direction:column;align-items:center;justify-content:center;gap:10px;margin:0;padding:24px 56px;border-radius:18px;background:#fff;direction:rtl}.ms-reviews__slider blockquote div{color:#f5bd27;font-size:24px;font-weight:400;letter-spacing:4px}.ms-reviews__slider blockquote p{margin:4px 0 18px;color:#333;font-size:17px;line-height:30px;text-align:center}.ms-reviews__slider cite{font-size:16px;font-style:normal;font-weight:700}.ms-reviews__slider small{color:#aaa;font-size:14px}.ms-reviews__arrow{display:grid;width:42px;height:42px;flex:0 0 42px;padding:0;place-items:center;border:2px solid #ddd;border-radius:50%;background:#fff;color:#777;font:32px/1 Arial}.ms-reviews__dots{position:absolute;bottom:0;left:50%;display:flex;gap:7px;transform:translateX(-50%)}.ms-reviews__dots i{width:8px;height:8px;border-radius:50%;background:#c4d1cf}.ms-reviews__dots i:first-child{width:22px;border-radius:4px;background:#1f5348}
@media(max-width:767px){.ms-reviews{height:445px}.ms-reviews__inner{flex-direction:column;gap:16px;padding:19.5px 14px}.ms-reviews__info{width:347px;height:139px;flex:0 0 139px;align-items:center}.ms-reviews__info h2{width:347px;font-size:22px;font-weight:800;line-height:26px;text-align:center}.ms-reviews__info>div{flex-direction:column;gap:8px}.ms-reviews__info b{font-size:16px}.ms-reviews__info p{font-size:13px;font-weight:500;line-height:18.85px}.ms-reviews__slider{width:329px;height:251px;flex:0 0 251px;padding:0 0 26px}.ms-reviews__slider blockquote{width:343px;height:225px;flex:0 0 343px;transform:translateX(-7px);padding:20px 35px;border-radius:18px}.ms-reviews__slider blockquote div{font-size:24px}.ms-reviews__slider blockquote p{margin:4px 0 0;font-size:17px;line-height:30px}.ms-reviews__slider blockquote cite{font-size:16px}.ms-reviews__slider blockquote small{font-size:14px}.ms-reviews__slider .ms-reviews__arrow{display:none}}
{% endstylesheet %}
{% schema %}
{"name":"MS — Reviews","max_blocks":5,"settings":[{"type":"text","id":"badge","label":"Badge","default":"شهادات العملاء"},{"type":"text","id":"heading","label":"Heading","default":"مئات من التقييمات 5 نجوم"},{"type":"text","id":"summary","label":"Summary","default":"أكثر من 1,500 عميل سعيد من طلباته"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"textarea","id":"text","label":"Review","default":"محاشي ستيشن، طازجة ولذيذة! المحاشي كلها طازة والتغليف مرتب، وصلني الأكل حار وأنيق."},{"type":"text","id":"author","label":"Author","default":"فهد المنيفي"},{"type":"text","id":"location","label":"Location","default":"الكويت - الجهراء"}]}],"presets":[{"name":"MS — Reviews","blocks":[{"type":"review"}]}]}
{% endschema %}
