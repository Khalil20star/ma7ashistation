{%- assign featured_collection = section.settings.collection | default: collections.all -%}
<section class="ms-home ms-best">
  <div class="ms-home__container">
    <h2 class="ms-home__title">{{ section.settings.heading }}</h2>
    <div class="ms-best__viewport ms-home__rail">
      <div class="ms-best__grid">
        {%- for product in featured_collection.products limit: 8 -%}
          {% render 'ms-product-card', product: product, badge: section.settings.badge, button_label: section.settings.button_label %}
        {%- endfor -%}
      </div>
    </div>
    <a class="ms-best__all" href="{{ section.settings.link | default: featured_collection.url | default: routes.all_products_collection_url }}">{{ section.settings.link_label }}</a>
  </div>
</section>
{% stylesheet %}
.ms-best{height:1264px;overflow:hidden;background:#e1c4a9}.ms-best>.ms-home__container{height:100%;padding-top:40px;padding-bottom:40px}.ms-best .ms-home__title{line-height:26px}.ms-best__viewport{margin-top:24px;overflow:hidden}.ms-best__grid{display:flex;width:100%;height:1062px;flex-wrap:wrap;gap:40px 16px;direction:ltr}.ms-best__grid>.ms-product-card{direction:rtl}.ms-best__all{display:grid;width:166px;height:48px;margin:24px auto 0;place-items:center;border:1px solid #1f423d;border-radius:50px;color:#1f423d;font-size:20px;font-weight:700}@media(max-width:767px){.ms-best{height:367px}.ms-best>.ms-home__container{padding:16px 7.5px 14px}.ms-best .ms-home__title{line-height:26px}.ms-best__viewport{width:360px;height:250px;margin-top:16px;overflow:hidden}.ms-best__grid{width:max-content;height:250px;flex-wrap:nowrap;gap:3.66px;transform:translateX(-120px)}.ms-best__all{width:127px;height:29px;margin-top:16px;font-size:14px}}
{% endstylesheet %}
{% schema %}
{"name":"MS — Best sellers","settings":[{"type":"text","id":"heading","label":"Heading","default":"منتجاتنا الأكثر مبيعا"},{"type":"collection","id":"collection","label":"Collection"},{"type":"text","id":"badge","label":"Product badge","default":"⚡ الأكثر مبيعا"},{"type":"text","id":"button_label","label":"Add button","default":"أضف إلى السلة"},{"type":"text","id":"link_label","label":"View all label","default":"تسوق الكل"},{"type":"url","id":"link","label":"View all link"}],"presets":[{"name":"MS — Best sellers"}]}
{% endschema %}
