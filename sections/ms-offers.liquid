{%- assign offers_collection = section.settings.collection | default: collections.all -%}
<section class="ms-home ms-offers">
  <div class="ms-home__container">
    <header class="ms-offers__header">
      <span class="ms-offers__badge">{{ section.settings.badge }} <b>⚡</b></span>
      <h2 class="ms-home__title">{{ section.settings.heading }}</h2>
      <p class="ms-home__subtitle">{{ section.settings.text }}</p>
    </header>
    <nav class="ms-offers__tabs" aria-label="{{ section.settings.tabs_label | escape }}">
      <a href="{{ section.settings.tab_1_link | default: offers_collection.url }}">{{ section.settings.tab_1 }}</a>
      <a href="{{ section.settings.tab_2_link | default: offers_collection.url }}">{{ section.settings.tab_2 }}</a>
      <a class="is-active" href="{{ section.settings.tab_3_link | default: offers_collection.url }}">{{ section.settings.tab_3 }}</a>
    </nav>
    <div class="ms-offers__viewport ms-home__rail">
      <div class="ms-offers__grid">
        {%- for product in offers_collection.products limit: 7 -%}
          {%- assign variant = product.selected_or_first_available_variant -%}
          <article class="ms-offers__item">
            <a class="ms-offers__media" href="{{ product.url }}">
              {%- if product.featured_image -%}{{ product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', width: 64, height: 64, alt: product.title }}{%- endif -%}
            </a>
            <div class="ms-offers__copy">
              <span>⚡ {{ section.settings.sale_label }}</span>
              <a href="{{ product.url }}">{{ product.title }}</a>
              <p>{% if variant.compare_at_price > variant.price %}<s>{{ variant.compare_at_price | money_without_trailing_zeros }}</s>{% endif %}<strong>{{ variant.price | money_without_trailing_zeros }}</strong></p>
            </div>
            {%- form 'product', product, class: 'ms-offers__form' -%}
              <input type="hidden" name="id" value="{{ variant.id }}">
              <button type="submit" name="add" aria-label="{{ section.settings.add_label | escape }}" {% unless variant.available %}disabled{% endunless %}>+</button>
            {%- endform -%}
          </article>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{% stylesheet %}
.ms-offers{height:603px;overflow:hidden;background:#fafafa}.ms-offers>.ms-home__container{height:100%;padding-top:40px}.ms-offers__header{display:flex;height:116px;flex-direction:column;align-items:center;gap:8px}.ms-offers__badge{display:flex;width:133px;height:32px;align-items:center;justify-content:center;gap:6px;margin-bottom:8px;border-radius:50px;background:#1f423d;color:#fff;font-size:13px;font-weight:500}.ms-offers__badge b{color:#e8a020}.ms-offers__tabs{display:flex;height:54px;margin-top:31px;align-items:stretch;justify-content:flex-end;border-bottom:1px solid #ddd}.ms-offers__tabs a{display:grid;min-width:128px;padding:0 28px;place-items:center;color:#888;font-size:16px;font-weight:700;white-space:nowrap}.ms-offers__tabs a:first-child{min-width:162px}.ms-offers__tabs a.is-active{border-bottom:2px solid #1b5735;color:#1b4d2e}.ms-offers__viewport{height:366px;margin-top:31px;overflow:hidden}.ms-offers__grid{display:grid;grid-template-columns:repeat(3,1fr);grid-auto-rows:90px;gap:15px 8px;direction:ltr}.ms-offers__item{display:flex;height:90px;align-items:center;gap:12px;padding:12px;border:1px solid #dedede;border-radius:14px;background:#fff;direction:rtl}.ms-offers__media,.ms-offers__media img{display:block;width:64px;height:64px;flex:0 0 64px;border-radius:10px;object-fit:cover}.ms-offers__copy{min-width:0;flex:1}.ms-offers__copy>span{display:grid;width:max-content;min-width:92px;height:20px;margin-bottom:1px;padding:0 9px;place-items:center;border-radius:14px;background:#fff0d9;color:#c47c0a;font-size:10px;font-weight:700}.ms-offers__copy>a{display:block;overflow:hidden;height:18px;color:#1f423d;font-size:13px;font-weight:800;line-height:17.55px;white-space:nowrap;text-overflow:ellipsis}.ms-offers__copy p{display:flex;align-items:center;gap:6px;margin:1px 0 0}.ms-offers__copy s{color:#aaa;font-size:12px}.ms-offers__copy strong{color:#1b4d2e;font-size:14px;font-weight:800}.ms-offers__form{order:3}.ms-offers__form button{display:grid;width:32px;height:32px;padding:0;place-items:center;border:0;border-radius:50%;background:#1b5735;color:#fff;font:20px/1 Arial;cursor:pointer}
@media(max-width:767px){.ms-offers{height:524px}.ms-offers>.ms-home__container{padding-top:16px}.ms-offers__header{height:101px}.ms-offers__header .ms-home__title{margin-top:8px}.ms-offers__header .ms-home__subtitle{font-weight:500}.ms-offers__badge{margin:0}.ms-offers__tabs{width:360px;height:54px;margin:16px -8.5px 0;justify-content:center}.ms-offers__tabs a,.ms-offers__tabs a:first-child{min-width:103px;padding:0 10px;font-size:13px;font-weight:500;line-height:18.85px}.ms-offers__viewport{width:343px;height:321px;margin-top:16px;overflow:hidden}.ms-offers__grid{display:flex;width:760px;height:300px;flex-wrap:wrap;gap:15px 8px;transform:translateX(-417px)}.ms-offers__item{width:248px;flex:0 0 248px}.ms-offers__item:nth-child(7){margin-inline-start:256px}.ms-offers__copy>span{min-width:92px}.ms-offers__form button{width:32px;height:32px}}
.ms-offers__tabs{direction:ltr}.ms-offers__tabs a{direction:rtl}.ms-offers__copy p{justify-content:flex-end;direction:ltr}
{% endstylesheet %}
{% schema %}
{"name":"MS — Offers","settings":[{"type":"text","id":"badge","label":"Badge","default":"في التخفيضات"},{"type":"text","id":"heading","label":"Heading","default":"عروض خاصة لاستكمال طلبك!"},{"type":"text","id":"text","label":"Description","default":"عروض محدودة الوقت. اغتنمها قبل أن تفوتك!"},{"type":"text","id":"tabs_label","label":"Tabs accessibility label","default":"تصنيفات العروض"},{"type":"text","id":"tab_1","label":"Tab 1","default":"مشروبات باردة"},{"type":"url","id":"tab_1_link","label":"Tab 1 link"},{"type":"text","id":"tab_2","label":"Tab 2","default":"الصوصات"},{"type":"url","id":"tab_2_link","label":"Tab 2 link"},{"type":"text","id":"tab_3","label":"Tab 3","default":"حلويات مبردة"},{"type":"url","id":"tab_3_link","label":"Tab 3 link"},{"type":"collection","id":"collection","label":"Products collection"},{"type":"text","id":"sale_label","label":"Sale label","default":"في التخفيضات"},{"type":"text","id":"add_label","label":"Add button label","default":"أضف إلى السلة"}],"presets":[{"name":"MS — Offers"}]}
{% endschema %}
