<section class="ms-home ms-announcement" aria-label="{{ section.settings.accessibility_label | escape }}">
  <div class="ms-announcement__inner">
    <span class="ms-announcement__badge">{{ section.settings.badge }}</span>
    <p>{{ section.settings.text }}</p>
    <span class="ms-announcement__code">{{ section.settings.code }}</span>
  </div>
</section>
{% stylesheet %}
.ms-announcement{height:41px;overflow:hidden;background:#1f423d;color:#fff}.ms-announcement__inner{display:flex;width:100%;height:41px;align-items:center;justify-content:center;gap:12px;padding:10px 16px;white-space:nowrap}.ms-announcement p{margin:0;font-size:13px;font-weight:500;line-height:16px}.ms-announcement__code{display:grid;width:76px;height:20px;place-items:center;border-radius:6px;background:#335e43;font-size:13px;font-weight:400}.ms-announcement__badge{display:grid;width:78px;height:21px;place-items:center;border-radius:5px;background:#b3261e;font-size:9px;font-weight:900}@media(max-width:767px){.ms-announcement,.ms-announcement__inner{height:36px}.ms-announcement__inner{position:relative;left:50%;width:max-content;min-width:0;padding:10px 0;transform:translateX(-50%)}.ms-announcement p{font-size:13px}.ms-announcement__code,.ms-announcement__badge{display:none}}
{% endstylesheet %}
{% schema %}
{"name":"MS — Announcement","settings":[{"type":"text","id":"accessibility_label","label":"Accessibility label","default":"إعلان"},{"type":"text","id":"code","label":"Discount code","default":"NOW30"},{"type":"text","id":"text","label":"Text","default":"خصم 10% على اي طلب عن طريق الموقع — استخدم الكوبون عند الطلب"},{"type":"text","id":"badge","label":"Badge","default":"عرض محدود"}],"presets":[{"name":"MS — Announcement"}]}
{% endschema %}
