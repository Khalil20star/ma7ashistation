{%- comment -%}
  Adapter for theme grids, AJAX results and sliders. Keep the outer layout
  classes, but render the same card used on the homepage inside them.
{%- endcomment -%}
{%- capture card_context -%}{{ section_id }}-{{ class | handleize }}{%- endcapture -%}
<div class="ms-home ms-theme-card hdt-card-product {{ class }}{% unless card_product.available %} hdt-pr-sold_out{% endunless %}">
  {%- render 'ms-product-card', product: card_product, product_url: product_url, sizes: sizes, card_context: card_context, choose_options: true -%}
</div>
